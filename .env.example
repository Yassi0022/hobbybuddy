# HobbyBuddy — Development / template environment variables
# Production values must come from Aiven Console (host, port, db, user, pass, SSL settings).
# Never commit real secrets to this file.

# --- Aiven / Database (rotate production values in Aiven dashboard) ---
# These names reference the variables used by render.yaml and docker-compose.yml.
MYSQL_DATABASE=***
MYSQL_ROOT_PASSWORD=***
MYSQL_USER=***
MYSQL_PASSWORD=***
AIVEN_URL=***
AIVEN_USER=***
AIVEN_PASSWORD=***

# --- Email (default disabled to avoid SMTP startup block) ---
EMAIL_ENABLED=false
EMAIL_FROM=noreply@hobbybuddy.com
EMAIL_HOST=***
EMAIL_PORT=***
EMAIL_USERNAME=***
EMAIL_PASSWORD=***

# --- Application ---
SPRING_PROFILES_ACTIVE=dev
FRONTEND_URL=https://hobbybuddy.vercel.app
FRONTEND_ORIGINS=https://hobbybuddy.vercel.app,https://*.vercel.app
FASTAPI_URL=***

# Note: SMTP_USER / SMTP_PASSWORD variables are NOT defined in this project.
# Email uses EMAIL_USERNAME / EMAIL_PASSWORD (per render.yaml).
