# Development / local datasource placeholders ONLY.
# Production values must come from Aiven Console (host, port, db, user, pass, SSL settings).
# Required JDBC TLS settings for Aiven MySQL: useSSL=true, requireSSL=true
# Example production format (DO NOT USE REAL VALUES):
# SPRING_DATASOURCE_URL=jdbc:mysql://HOST_PLACEHOLDER:PORT_PLACEHOLDER/DATABASE_PLACEHOLDER?useSSL=true&requireSSL=true
MYSQL_DATABASE=REDACTED_PLACEHOLDER
MYSQL_ROOT_PASSWORD=REDACTED_PLACEHOLDER
MYSQL_USER=REDACTED_PLACEHOLDER
MYSQL_PASSWORD=REDACTED_PLACEHOLDER
AIVEN_URL=jdbc:mysql://REDACTED_HOST:REDACTED_PORT/REDACTED_DB?useSSL=true&requireSSL=true
AIVEN_USER=REDACTED_USERNAME
AIVEN_PASSWORD=REDACTED_PASSWORD
